# Requires cgroup controllers enabled globally first, in /etc/rc.conf:
#   rc_controller_cgroups="YES"
#   rc_cgroup_controllers="memory pids"
rc_cgroup_settings="

#idle does not exceed 2M, ~1.1M on release build and ~23M on debug, although you won't be using debug 
memory.max 268435456

#still might be a lot, limit more or less if you want to, depending on your config
#it's here to prevent any kinds of event->script->event loops
pids.max 50
"
